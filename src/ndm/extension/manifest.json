{
  "manifest_version": 3,
  "name": "NDM Capture",
  "version": "0.1.0",
  "description": "Opt-in media link capture for your own NDM download daemon.",
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "NDM Capture settings" }
}
