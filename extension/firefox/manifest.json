{
  "manifest_version": 2,
  "name": "NDM Download Handoff",
  "version": "1.0.0",
  "description": "Hand Firefox downloads to NDM, which asks you in the app before starting them.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ndm@x017.github.io",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "notifications",
    "menus"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_title": "NDM Download Handoff",
    "default_popup": "popup.html"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  }
}
